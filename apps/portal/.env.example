# Register "Virex" as a merchant in the Qorve business dashboard
# (business.qorve.com, http://localhost:3003 in local dev) and paste its
# publishable key below. Never use the qk_live_* secret key here — this
# value ships to every visitor's browser.
NEXT_PUBLIC_QORVE_MERCHANT_PUBLISHABLE_KEY=qk_pub_xxxxxxxx

# Local dev defaults — see qorve/.env.example's port map (pay.qorve.com/api.qorve.com
# run on localhost:3004/3001 locally). Point these at the real
# https://checkout.qorve.com / https://api.qorve.com once Qorve is deployed.
NEXT_PUBLIC_QORVE_CHECKOUT_URL=http://localhost:3004
NEXT_PUBLIC_QORVE_API_URL=http://localhost:3001/api
