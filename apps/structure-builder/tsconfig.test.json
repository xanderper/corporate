{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": ".test-build",
    "rootDir": ".",
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2022",
    "jsx": "react-jsx",
    "incremental": false,
    "plugins": [],
    "types": ["node"]
  },
  "include": ["src/lib/**/*.ts", "tests/**/*.test.ts"]
}
